meta {
  name: Edit Message - Empty Content
  type: http
  seq: 4
}

put {
  url: {{base_url}}/messages/{{message_id}}
  body: json
  auth: none
  
  body:json {
    "content": ""
  }
}

tests {
  test("Should return 400 for empty content", function() {
    expect(res.status).to.equal(400);
  });
}

vars:secret {
  base_url: env.BASE_URL,
  message_id: env.MESSAGE_ID
}